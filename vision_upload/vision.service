[Unit]
Description=Robot Vision System v6 (HSV + AprilTag)
After=network.target

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/vision_upload

# 板载串口不需要等USB枚举
ExecStartPre=/bin/sh -c 'ls /dev/ttyUSB* 2>/dev/null && echo "USB-TTL ready" || echo "WARN: no ttyUSB found, will auto-detect"'

# backend=color: 纯HSV检测
ExecStart=/usr/bin/python3 main.py --color b --priority-mode attack --backend color --no-stream

Restart=always
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=10

# === env vars ===
Environment=PYTHONUNBUFFERED=1
# UART 自动探测: ttySTM32 symlink > ttyUSB* > ttyAS1
#Environment=VISION_UART=/dev/ttyUSB0
Environment=VISION_FPS=20
Environment=VISION_STATUS_INTERVAL_S=5.0
Environment=VISION_CLAHE=1
Environment=VISION_AUTO_WB=0
Environment=VISION_WB_TEMP=4200
Environment=VISION_UART_RETRIES=3
Environment=VISION_TRACK_CONFIRM=3

[Install]
WantedBy=multi-user.target
